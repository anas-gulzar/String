#include <stdio.h>

int main() {
    char str[100];
    printf("enter a word (upercase/lowercase):");
    scanf("%s", str);

    for(int i=0; str[i]!='\0'; i++){
        if(str[i]<97){
            str[i]=str[i]+32;
        }else{
            str[i]=str[i]-32;
        }
    }
    printf("transformed word is : %s", str);
    return 0;
}
