#include <stdio.h>

int main() {
    char str[100];

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    int count = 0;

    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] != ' ' &&
            (i == 0 || str[i - 1] == ' ')) {
            count++;
        }
    }

    printf("Total words are: %d", count);

    return 0;
}
