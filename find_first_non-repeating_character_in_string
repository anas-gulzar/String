#include <stdio.h>

int main() {
    char name[100];
    printf("enter your word :");
    scanf("%s",name);

    int found=0;

    for(int i = 0; name[i] != '\0'; i++){
        int count=0;
        for(int j=0; name[j]!='\0'; j++){
        if(name[i]==name[j]){
           count++;
    }
}
         if(count==1){
        printf("first non-repeating character is : %c",name[i]);
             found = 1;
        break;
    }
}
     if(found==0){
            printf("no non-repeating character found!");
        }
    return 0;
}
